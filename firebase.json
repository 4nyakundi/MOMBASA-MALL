{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "package.json",
      "package-lock.json",
      "*.md",
      "scratch/**"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/stores",
        "destination": "/stores/index.html"
      },
      {
        "source": "/led-advertising",
        "destination": "/led-advertising/index.html"
      },
      {
        "source": "/activations",
        "destination": "/activations/index.html"
      }
    ]
  }
}
