{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "database/**",
      "tests/**",
      "package.json",
      "package-lock.json",
      "*.md",
      "scratch/**",
      "tmp/**",
      "**/original_*"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/stores",
        "destination": "/stores/index.html"
      },
      {
        "source": "/led-advertising",
        "destination": "/led-advertising/index.html"
      },
      {
        "source": "/activations",
        "destination": "/activations/index.html"
      },
      {
        "source": "/playon",
        "destination": "/playon/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/play-on.html",
        "destination": "/playon/index.html",
        "type": 301
      },
      {
        "source": "/led.html",
        "destination": "/led-advertising/index.html",
        "type": 301
      },
      {
        "source": "/Play-On",
        "destination": "/playon/index.html",
        "type": 301
      },
      {
        "source": "/Play-On/",
        "destination": "/playon/index.html",
        "type": 301
      },
      {
        "source": "/Play-On/index.html",
        "destination": "/playon/index.html",
        "type": 301
      }
    ]
  }
}
