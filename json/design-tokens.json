{
  "systemName": "Mombasa Mall Coastal Modern Design System",
  "version": "2.0.0",
  "tokens": {
    "colors": {
      "primary": {
        "navy": "#0A1D37",
        "navyLight": "#0E294B",
        "navyDeep": "#050F1D"
      },
      "secondary": {
        "sand": "#F4F1EA",
        "sandWarm": "#E8E3D7",
        "sandDeep": "#DDD6C5"
      },
      "accent": {
        "coral": "#FF6F59",
        "coralLight": "#FF8A75",
        "coralDeep": "#E25640"
      },
      "neutral": {
        "slate": "#1A2530",
        "slateLight": "#2C3A47",
        "slateMuted": "#4B5966",
        "slateIce": "#F0F4F8"
      }
    },
    "typography": {
      "fonts": {
        "headings": "Clash Display, Syne, sans-serif",
        "body": "Satoshi, Plus Jakarta Sans, sans-serif"
      },
      "letterSpacing": {
        "tight": "-0.03em",
        "normal": "0em",
        "wide": "0.05em",
        "widest": "0.1em"
      },
      "lineHeight": {
        "none": "1",
        "tight": "1.15",
        "snug": "1.3",
        "normal": "1.5",
        "relaxed": "1.625"
      },
      "clampScales": {
        "display1": "clamp(3rem, 6vw + 1rem, 5.5rem)",
        "display2": "clamp(2.2rem, 4vw + 0.8rem, 4rem)",
        "h1": "clamp(1.8rem, 3.5vw + 0.5rem, 3rem)",
        "h2": "clamp(1.5rem, 2.5vw + 0.4rem, 2.2rem)",
        "h3": "clamp(1.2rem, 1.8vw + 0.3rem, 1.7rem)",
        "body": "clamp(0.95rem, 0.2vw + 0.85rem, 1.1rem)",
        "small": "clamp(0.75rem, 0.1vw + 0.7rem, 0.88rem)"
      }
    },
    "glassmorphism": {
      "backdropFilter": {
        "light": "blur(12px) saturate(140%)",
        "medium": "blur(20px) saturate(180%)",
        "heavy": "blur(30px) saturate(200%)"
      },
      "backgroundOpacity": {
        "glassLight": "rgba(244, 241, 234, 0.65)",
        "glassDark": "rgba(10, 29, 55, 0.7)",
        "glassCoral": "rgba(255, 111, 89, 0.15)"
      },
      "borderGlow": {
        "light": "1px solid rgba(255, 255, 255, 0.25)",
        "dark": "1px solid rgba(255, 255, 255, 0.08)",
        "coral": "1px solid rgba(255, 111, 89, 0.3)"
      }
    },
    "elevation": {
      "shadows": {
        "flat": "0 0 0 1px rgba(0, 0, 0, 0.05)",
        "ambient": "0 10px 30px rgba(10, 29, 55, 0.04)",
        "elevated": "0 20px 40px rgba(10, 29, 55, 0.08)",
        "glowCoral": "0 15px 30px rgba(255, 111, 89, 0.15)"
      }
    }
  }
}
