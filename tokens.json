{
  "systemName": "Mombasa Mall Coastal Luxury Design System",
  "version": "3.0.0",
  "tokens": {
    "colors": {
      "primary": {
        "navy": "#0A192F",
        "navyLight": "#112240",
        "navyDeep": "#020C1B"
      },
      "secondary": {
        "sandstone": "#F8F5F0",
        "sandstoneWarm": "#EFEAE2",
        "sandstoneDeep": "#E5DCD0"
      },
      "accent": {
        "coral": "#FF6B4A",
        "coralLight": "#FF8E75",
        "coralDeep": "#E04F2F",
        "gold": "#D4AF37",
        "goldLight": "#F3E5AB",
        "goldDeep": "#AA7C11"
      },
      "neutral": {
        "slate": "#1A2530",
        "slateLight": "#2C3A47",
        "slateMuted": "#4B5966",
        "slateIce": "#F0F4F8"
      }
    },
    "typography": {
      "fonts": {
        "headings": "Clash Display, Syne, sans-serif",
        "body": "Satoshi, Plus Jakarta Sans, sans-serif"
      },
      "letterSpacing": {
        "tight": "-0.03em",
        "normal": "0em",
        "wide": "0.06em",
        "widest": "0.12em"
      },
      "lineHeight": {
        "none": "1",
        "tight": "1.15",
        "snug": "1.3",
        "normal": "1.5",
        "relaxed": "1.65"
      },
      "clampScales": {
        "display1": "clamp(3.2rem, 6.5vw + 1.2rem, 6rem)",
        "display2": "clamp(2.4rem, 4.5vw + 0.9rem, 4.5rem)",
        "h1": "clamp(1.9rem, 3.8vw + 0.6rem, 3.2rem)",
        "h2": "clamp(1.6rem, 2.8vw + 0.5rem, 2.4rem)",
        "h3": "clamp(1.3rem, 2vw + 0.35rem, 1.8rem)",
        "body": "clamp(0.95rem, 0.2vw + 0.85rem, 1.15rem)",
        "small": "clamp(0.75rem, 0.1vw + 0.7rem, 0.9rem)"
      }
    },
    "glassmorphism": {
      "backdropFilter": {
        "light": "blur(14px) saturate(150%)",
        "medium": "blur(22px) saturate(190%)",
        "heavy": "blur(32px) saturate(210%)"
      },
      "backgroundOpacity": {
        "glassLight": "rgba(248, 245, 240, 0.7)",
        "glassDark": "rgba(10, 25, 47, 0.75)",
        "glassGold": "rgba(212, 175, 55, 0.15)"
      },
      "borderGlow": {
        "light": "1px solid rgba(255, 255, 255, 0.3)",
        "dark": "1px solid rgba(255, 255, 255, 0.1)",
        "gold": "1px solid rgba(212, 175, 55, 0.35)"
      }
    },
    "motion": {
      "timing": {
        "entrance": "0.8s",
        "hover": "0.3s",
        "exit": "0.5s"
      },
      "easing": {
        "smooth": "power3.out",
        "fluid": "power4.inOut",
        "elastic": "elastic.out(1, 0.45)"
      }
    }
  }
}
